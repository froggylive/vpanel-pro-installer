<%- include('../../partials/head', { title: 'Support Tickets' }) %>
<%- include('../../partials/sidebar', { activePage:'support', navArea:'user' }) %>
<div class="main-wrap"><%- include('../../partials/topbar', { breadcrumbs:[{label:'Support'},{label:'Tickets'}] }) %>
<main class="content">
  <div class="page-head"><div><h1 class="page-title">Support Tickets</h1><p class="page-sub">Get help from the support team.</p></div><div class="page-actions"><button class="btn btn-primary" onclick="newTicket.style.display='block'">Open Ticket</button></div></div>
  <div class="card" id="newTicket" style="display:none;margin-bottom:16px"><div class="card-h"><div class="card-t">Open Ticket</div></div><div class="card-b"><form id="tForm"><div class="form-grid"><div class="field"><label class="label">Subject</label><input class="input" name="subject" required></div><div class="field"><label class="label">Department</label><select class="input" name="department"><option>General</option><option>Technical</option><option>Billing</option></select></div></div><div class="form-grid"><div class="field"><label class="label">Priority</label><select class="input" name="priority"><option value="low">Low</option><option value="medium" selected>Medium</option><option value="high">High</option><option value="urgent">Urgent</option></select></div></div><div class="field"><label class="label">Message</label><textarea class="input" name="message" required></textarea></div><button class="btn btn-primary">Submit Ticket</button></form></div></div>
  <div class="card"><div class="table-wrap"><table><thead><tr><th>Subject</th><th>Department</th><th>Priority</th><th>Status</th><th>Updated</th><th></th></tr></thead><tbody>
    <% if(!tickets.length){ %><tr><td colspan="6"><div class="table-empty">No support tickets.</div></td></tr><% } %>
    <% tickets.forEach(t=>{ %><tr><td><div style="font-weight:500"><%= t.subject %></div><div class="muted2 mono">#<%= t.id %></div></td><td class="muted"><%= t.department %></td><td><span class="badge <%= t.priority==='urgent'||t.priority==='high'?'badge-red':t.priority==='medium'?'badge-yellow':'badge-gray' %>"><%= t.priority %></span></td><td><span class="badge <%= t.status==='open'?'badge-green':t.status==='answered'?'badge-blue':t.status==='closed'?'badge-gray':'badge-yellow' %>"><%= t.status %></span></td><td class="muted"><%= new Date(t.updated_at||t.created_at).toLocaleString() %></td><td style="text-align:right"><a class="btn btn-sm" href="/support/<%=t.id%>">View</a></td></tr><% }) %>
  </tbody></table></div></div>
</main></div>
<script>tForm.onsubmit=async e=>{e.preventDefault(); const fd=new FormData(e.target); try{ const r=await VP.api('/support',{method:'POST',body:Object.fromEntries(fd)}); location.href=r.redirect; }catch(err){VP.toast(err.message,'error')} }</script>
<%- include('../../partials/foot') %>
