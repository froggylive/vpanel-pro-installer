<%- include('../../partials/head', { title: 'Ticket #' + ticket.id }) %>
<%- include('../../partials/sidebar', { activePage:'support', navArea:'user' }) %>
<div class="main-wrap"><%- include('../../partials/topbar', { breadcrumbs:[{label:'Support',href:'/support'},{label:'Ticket #'+ticket.id}] }) %>
<main class="content">
  <div class="page-head"><div><h1 class="page-title"><%= ticket.subject %></h1><p class="page-sub">#<%= ticket.id %> · <%= ticket.department %> · <span class="badge <%= ticket.status==='open'?'badge-green':ticket.status==='answered'?'badge-blue':'badge-gray' %>"><%= ticket.status %></span></p></div><div class="page-actions"><% if(ticket.status!=='closed'){ %><button class="btn btn-danger" onclick="closeTicket()">Close Ticket</button><% } %></div></div>
  <div class="card" style="margin-bottom:16px"><div class="card-b" style="display:flex;flex-direction:column;gap:14px">
    <% ticket.messages.forEach(m=>{ const mine=Number(m.user_id)===Number(user.id); %>
      <div style="max-width:820px;<%= mine?'margin-left:auto;':'' %>"><div style="font-size:12px;color:var(--muted2);margin-bottom:4px"><%= m.username %> · <%= new Date(m.created_at).toLocaleString() %></div><div style="background:<%= mine?'rgba(255,255,255,.08)':'#111111' %>;border:1px solid <%= mine?'rgba(255,255,255,.15)':'var(--border)' %>;padding:12px 14px;border-radius:12px;white-space:pre-wrap"><%= m.message %></div></div>
    <% }) %>
  </div></div>
  <% if(ticket.status!=='closed'){ %>
  <div class="card"><div class="card-h"><div class="card-t">Reply</div></div><div class="card-b"><form id="rForm"><div class="field"><textarea class="input" name="message" required placeholder="Write your reply..."></textarea></div><button class="btn btn-primary">Send Reply</button></form></div></div>
  <% } %>
</main></div>
<script>
rForm && (rForm.onsubmit=async e=>{e.preventDefault(); try{ await VP.api('/support/<%=ticket.id%>/reply',{method:'POST',body:{message:new FormData(e.target).get('message')}}); location.reload(); }catch(err){VP.toast(err.message,'error')} });
async function closeTicket(){ if(!await VP.confirm('Close this ticket?',{danger:true})) return; await VP.api('/support/<%=ticket.id%>/close',{method:'POST'}); location.reload(); }
</script><%- include('../../partials/foot') %>
