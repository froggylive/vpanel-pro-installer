<div class="card"><div class="card-h"><div class="card-t">Backups</div><button class="btn btn-primary btn-sm" onclick="createBackup()">Create Backup</button></div>
<div class="table-wrap"><table><thead><tr><th>Name</th><th>Size</th><th>Created</th><th style="text-align:right">Actions</th></tr></thead><tbody>
<% if(!backups.length){ %><tr><td colspan="4"><div class="table-empty">No backups yet.</div></td></tr><% } %>
<% backups.forEach(b=>{ %><tr><td><div style="font-weight:500"><%= b.name||('Backup #'+b.id) %></div><div class="muted2 mono">#<%= b.id %></div></td><td class="muted"><%= b.size? (Number(b.size)/1048576).toFixed(1)+' MB':'—' %></td><td class="muted"><%= new Date(b.created_at||Date.now()).toLocaleString() %></td><td><div style="display:flex;gap:6px;justify-content:flex-end"><a class="btn btn-sm btn-ghost" href="/server/<%=currentVm.id%>/backups/<%=b.id%>/download">Download</a><button class="btn btn-sm btn-ghost" onclick="restoreBackup(<%=b.id%>)">Restore</button><button class="btn btn-sm btn-danger" onclick="deleteBackup(<%=b.id%>)">Delete</button></div></td></tr><% }) %>
</tbody></table></div></div>
<script>
const vmId=<%=currentVm.id%>;
async function createBackup(){ const name=prompt('Backup name (optional):')||''; try{ await VP.api(`/server/${vmId}/backups/create`,{method:'POST',body:{name}}); VP.toast('Backup created','success'); location.reload(); }catch(e){VP.toast(e.message,'error')} }
async function restoreBackup(id){ if(!await VP.confirm('Restore this backup? Current disk data will be replaced.',{danger:true,okText:'Restore'})) return; try{ await VP.api(`/server/${vmId}/backups/${id}/restore`,{method:'POST'}); VP.toast('Restore started/completed','success'); }catch(e){VP.toast(e.message,'error')} }
async function deleteBackup(id){ if(!await VP.confirm('Delete this backup?',{danger:true,okText:'Delete'})) return; try{ await VP.api(`/server/${vmId}/backups/${id}/delete`,{method:'POST'}); location.reload(); }catch(e){VP.toast(e.message,'error')} }
</script>
