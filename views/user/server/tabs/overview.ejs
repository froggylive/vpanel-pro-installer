<div class="grid g-4" style="margin-bottom:20px">
  <div class="card"><div class="card-b"><div class="muted" style="font-size:12px">CPU</div><div style="font-size:24px;font-weight:700;margin:6px 0" id="cpuVal">—</div><div class="progress"><span id="cpuBar" style="width:0%"></span></div><div class="muted2" style="font-size:12px;margin-top:8px" id="cpuMeta"><%= currentVm.cpus %> vCPU allocated</div></div></div>
  <div class="card"><div class="card-b"><div class="muted" style="font-size:12px">Memory</div><div style="font-size:24px;font-weight:700;margin:6px 0" id="memVal">—</div><div class="progress"><span id="memBar" style="width:0%"></span></div><div class="muted2" style="font-size:12px;margin-top:8px" id="memMeta"><%= (Number(currentVm.memory||0)/1024).toFixed(1) %> GB allocated</div></div></div>
  <div class="card"><div class="card-b"><div class="muted" style="font-size:12px">Disk</div><div style="font-size:24px;font-weight:700;margin:6px 0" id="diskVal">—</div><div class="progress"><span id="diskBar" style="width:0%"></span></div><div class="muted2" style="font-size:12px;margin-top:8px" id="diskMeta"><%= currentVm.disk_size %> allocated</div></div></div>
  <div class="card"><div class="card-b"><div class="muted" style="font-size:12px">Network</div><div style="font-size:24px;font-weight:700;margin:6px 0" id="netVal">—</div><div class="muted2" style="font-size:12px;margin-top:8px" id="netMeta">Live counters not exposed by backend</div></div></div>
</div>
<div class="grid g-2">
  <div class="card"><div class="card-h"><div class="card-t">Server Details</div></div><div class="card-b">
    <div class="kv"><span class="k">Server ID</span><span class="v mono">#<%= currentVm.id %></span></div>
    <div class="kv"><span class="k">UUID</span><span class="v mono" style="font-size:11px"><%= currentVm.uuid %></span></div>
    <div class="kv"><span class="k">Location / Node</span><span class="v"><%= currentVm.node_name||'Local' %></span></div>
    <div class="kv"><span class="k">Operating System</span><span class="v"><%= currentVm.os_name||currentVm.os_type||'—' %></span></div>
    <div class="kv"><span class="k">IPv4 / SSH</span><span class="v mono"><%= currentVm.ssh_port?`127.0.0.1:${currentVm.ssh_port}`:'—' %></span></div>
    <div class="kv"><span class="k">VNC</span><span class="v mono"><%= currentVm.vnc_port||'—' %></span></div>
  </div></div>
  <div class="card"><div class="card-h"><div class="card-t">Recent Activity</div></div><div class="card-b" style="padding:0">
    <% if(!logs.length){ %><div class="empty"><p>No recent activity.</p></div><% } %>
    <% logs.slice(0,8).forEach(l=>{ %><div style="padding:12px 18px;border-bottom:1px solid var(--border);display:flex;justify-content:space-between;gap:12px"><div><div style="font-size:13px;font-weight:500"><%= l.event %></div><div class="muted2" style="font-size:12px"><%= l.details?JSON.stringify(l.details).slice(0,120):'' %></div></div><div class="muted2" style="font-size:12px;white-space:nowrap"><%= new Date(l.created_at||l.created||Date.now()).toLocaleString() %></div></div><% }) %>
  </div></div>
</div>
<script>
(async function(){ const id=<%=currentVm.id%>; async function r(){ try{ const res=await VP.api(`/server/${id}/status`); const s=res.stats||res; document.getElementById('statusBadge').textContent=s.status; document.getElementById('statusBadge').className='badge '+(s.status==='running'?'badge-green':s.status==='suspended'?'badge-red':'badge-gray');
 const cpu=Number(s.cpu?.percent||0); cpuVal.textContent=cpu.toFixed(1)+'%'; cpuBar.style.width=Math.min(100,cpu)+'%'; cpuBar.style.background=cpu>90?'var(--red)':cpu>70?'var(--yellow)':'var(--accent)';
 const mu=Number(s.memory?.used_mb||0), mt=Number(s.memory?.total_mb||1), mp=Number(s.memory?.percent||(mu/mt*100)); memVal.textContent=(mu/1024).toFixed(2)+' GB'; memMeta.textContent=`of ${(mt/1024).toFixed(1)} GB`; memBar.style.width=Math.min(100,mp)+'%'; memBar.style.background=mp>90?'var(--red)':mp>70?'var(--yellow)':'var(--accent)';
 const du=Number(s.disk?.actual_mb||0), dt=Number(s.disk?.allocated_mb||0), dp=Number(s.disk?.percent||0); diskVal.textContent=(du/1024).toFixed(2)+' GB'; diskMeta.textContent=dt?`of ${(dt/1024).toFixed(1)} GB allocated`:'Allocated <%=currentVm.disk_size%>'; diskBar.style.width=Math.min(100,dp)+'%'; diskBar.style.background=dp>90?'var(--red)':dp>70?'var(--yellow)':'var(--accent)';
 netVal.textContent='N/A'; }catch(e){} } r(); setInterval(r,10000); })();
</script>
