<div class="grid g-2">
  <div class="card"><div class="card-h"><div class="card-t">Power & Boot</div></div><div class="card-b">
    <div class="kv"><span class="k">Status</span><span class="v"><span class="badge <%= currentVm.status==='running'?'badge-green':currentVm.status==='suspended'?'badge-red':'badge-gray' %>"><%= currentVm.status %></span></span></div>
    <div class="kv"><span class="k">Start on boot</span><span class="v"><%= currentVm.autoboot ? 'Enabled' : 'Disabled' %></span></div>
    <div class="hint">Use power controls above. Reinstall and destructive actions require confirmation.</div>
  </div></div>
  <div class="card"><div class="card-h"><div class="card-t">Reinstall OS</div></div><div class="card-b">
    <p class="muted" style="font-size:13px;margin-top:0">Reinstalling erases all data on the Server disk. Back up important data first.</p>
    <div class="field"><label class="label">Operating System</label><select id="reOs" class="input"><% osList.forEach(o=>{ %><option value="<%=o[0]%>"><%=o[0]%></option><% }) %></select></div>
    <button class="btn btn-danger" onclick="reinstall()">Reinstall Server</button>
  </div></div>
  <div class="card"><div class="card-h"><div class="card-t">CPU Model</div></div><div class="card-b">
    <p class="muted" style="font-size:13px;margin-top:0">Changes apply after reboot. <b>host</b> passes host CPU features (best when KVM is available). On hosts without KVM, QEMU emulates CPU and performance will be slower.</p>
    <div class="field"><label class="label">CPU Model</label><select id="cpuModel" class="input">
      <% const cm = (currentVm.cpu_model||''); const opts=[['','Auto (recommended)'],['host','host (pass-through)'],['qemu64','qemu64 (compatible)'],['max','max (QEMU features)'],['kvm64','kvm64'],['Broadwell','Broadwell'],['Haswell','Haswell'],['IvyBridge','IvyBridge'],['SandyBridge','SandyBridge'],['Skylake-Server','Skylake-Server'],['Cascadelake-Server','Cascadelake-Server'],['EPYC','EPYC'],['EPYC-Rome','EPYC-Rome'],['EPYC-Milan','EPYC-Milan'],['Westmere','Westmere']]; opts.forEach(o=>{ %>
      <option value="<%=o[0]%>" <%=cm===o[0]?'selected':''%>><%=o[1]%></option>
      <% }) %>
    </select></div>
    <button class="btn" onclick="saveCpuModel()">Save CPU Model</button>
  </div></div>
</div>
<script>
async function reinstall(){ const os=document.getElementById('reOs').value; if(!await VP.confirm(`Reinstall ${os}? This will erase all disk data.`,{danger:true,okText:'Reinstall'})) return; try{ await VP.api(`/server/<%=currentVm.id%>/reinstall`,{method:'POST',body:{os}}); VP.toast('Reinstall started','success'); location.href='/server/<%=currentVm.id%>/overview'; }catch(e){ VP.toast(e.message,'error'); } }
async function saveCpuModel(){ const cpu_model=document.getElementById('cpuModel').value; try{ await VP.api(`/server/<%=currentVm.id%>/settings`,{method:'POST',body:{cpu_model}}); VP.toast('CPU model saved. Reboot server to apply.','success'); }catch(e){ VP.toast(e.message,'error'); } }
</script>
