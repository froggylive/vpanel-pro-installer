<div class="grid g-2">
  <div class="card"><div class="card-h"><div class="card-t">CPU</div></div><div class="card-b"><div class="kv"><span class="k">Allocation</span><span class="v"><%= currentVm.cpus %> vCPU</span></div><div class="kv"><span class="k">Live Usage</span><span class="v" id="rCpu">—</span></div><div class="progress" style="margin-top:12px"><span id="rCpuB" style="width:0%"></span></div><div class="hint">History chart requires persistent metrics storage; live value is refreshed from backend.</div></div></div>
  <div class="card"><div class="card-h"><div class="card-t">Memory</div></div><div class="card-b"><div class="kv"><span class="k">Allocation</span><span class="v"><%= (Number(currentVm.memory||0)/1024).toFixed(1) %> GB</span></div><div class="kv"><span class="k">Used</span><span class="v" id="rMem">—</span></div><div class="progress" style="margin-top:12px"><span id="rMemB" style="width:0%"></span></div></div></div>
  <div class="card"><div class="card-h"><div class="card-t">Storage</div></div><div class="card-b"><div class="kv"><span class="k">Allocation</span><span class="v"><%= currentVm.disk_size %></span></div><div class="kv"><span class="k">Used</span><span class="v" id="rDisk">—</span></div><div class="progress" style="margin-top:12px"><span id="rDiskB" style="width:0%"></span></div></div></div>
  <div class="card"><div class="card-h"><div class="card-t">Network</div></div><div class="card-b"><div class="kv"><span class="k">Download / Upload</span><span class="v">Not available</span></div><div class="hint">Backend does not currently expose live network throughput counters. No fake metrics are shown.</div></div></div>
</div>
<script>
(async function(){ const id=<%=currentVm.id%>; async function r(){ try{ const s=(await VP.api(`/vds/${id}/status`)).stats||{}; const cpu=Number(s.cpu?.percent||0); rCpu.textContent=cpu.toFixed(1)+'%'; rCpuB.style.width=Math.min(100,cpu)+'%'; const mu=Number(s.memory?.used_mb||0),mt=Number(s.memory?.total_mb||1),mp=Number(s.memory?.percent||(mu/mt*100)); rMem.textContent=`${(mu/1024).toFixed(2)} / ${(mt/1024).toFixed(1)} GB (${mp.toFixed(1)}%)`; rMemB.style.width=Math.min(100,mp)+'%'; const du=Number(s.disk?.actual_mb||0),dp=Number(s.disk?.percent||0); rDisk.textContent=`${(du/1024).toFixed(2)} GB (${dp.toFixed(1)}%)`; rDiskB.style.width=Math.min(100,dp)+'%'; }catch(e){} } r(); setInterval(r,10000); })();
</script>
