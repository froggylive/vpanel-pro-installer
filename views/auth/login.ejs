<%- include('../partials/head', { title: 'Sign In' }) %>
<div class="auth-wrap">
  <div class="auth-card">
    <div class="auth-brand">
      <% const pn = settings['panel.name'] || 'vPanel'; %>
      <div class="auth-mark">V</div>
      <div class="auth-title"><%= pn %></div>
      <div class="auth-sub">Sign in to your account</div>
    </div>

    <% if (typeof error !== 'undefined' && error) { %><div class="alert alert-error"><%= error %></div><% } %>
    <% if (typeof success !== 'undefined' && success) { %><div class="alert alert-success"><%= success %></div><% } %>

    <form method="post" action="/login" class="auth-form">
      <div class="field">
        <label class="label" for="username">Username or Email</label>
        <input class="input" type="text" id="username" name="username" value="<%= typeof username !== 'undefined' ? username : '' %>" required autofocus autocomplete="username" placeholder="Enter your username or email"/>
      </div>

      <div class="field">
        <div class="auth-row">
          <label class="label" for="password" style="margin:0">Password</label>
          <a href="/forgot" class="auth-link">Forgot password?</a>
        </div>
        <div class="input-pass">
          <input class="input" type="password" id="password" name="password" required autocomplete="current-password" placeholder="Enter your password"/>
          <button type="button" class="pass-toggle" onclick="togglePassVisibility('password', this)" aria-label="Show password">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" width="18" height="18"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
          </button>
        </div>
      </div>

      <% if (typeof tfa !== 'undefined' && tfa) { %>
      <div class="field">
        <label class="label" for="code">Two-Factor Code</label>
        <input class="input" type="text" id="code" name="code" placeholder="6-digit code" inputmode="numeric" autocomplete="one-time-code" required/>
      </div>
      <% } %>

      <button type="submit" class="btn btn-primary btn-block auth-submit">Sign In</button>
    </form>

    <% if (settings['security.allow_register'] !== '0') { %>
    <div class="auth-foot">
      <span class="muted">Don't have an account?</span>
      <a href="/register" class="auth-link-strong">Create account</a>
    </div>
    <% } %>
  </div>
</div>
<script>
function togglePassVisibility(id, btn) {
  const inp = document.getElementById(id);
  if (!inp) return;
  const show = inp.type === 'password';
  inp.type = show ? 'text' : 'password';
  btn.classList.toggle('active', show);
  btn.setAttribute('aria-label', show ? 'Hide password' : 'Show password');
}
</script>
<%- include('../partials/auth-foot') %>
