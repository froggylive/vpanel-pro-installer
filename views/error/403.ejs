<%- include('../partials/head', { title: title || '403 - Forbidden' }) %>
<%- include('../partials/ambient') %>
<div class="auth-wrap">
  <div class="auth-card" style="text-align:center;max-width:480px">
    <div style="width:44px;height:44px;border-radius:12px;background:#fff;color:#000;display:grid;place-items:center;font-weight:800;font-size:18px;margin:0 auto 20px">V</div>
    <div style="font-size:64px;font-weight:800;letter-spacing:-2px;line-height:1;margin:0 0 8px;color:#fff"><%= code || '403' %></div>
    <h1 style="font-size:20px;font-weight:700;color:#fff;margin:0 0 8px"><%= title || 'Access Denied' %></h1>
    <p style="font-size:13px;color:var(--muted);margin:0 0 24px;line-height:1.6"><%= message || 'You do not have permission to access this resource.' %></p>
    <div style="display:flex;gap:10px;justify-content:center">
      <a href="/dashboard" class="btn btn-primary">Return to Dashboard</a>
      <button onclick="history.back()" class="btn">Go Back</button>
    </div>
  </div>
</div>
<%- include('../partials/foot') %>
