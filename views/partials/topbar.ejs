<%
const crumbs = (typeof breadcrumbs !== 'undefined' && breadcrumbs) ? breadcrumbs : [];
%>
<header class="topbar">
  <div class="topbar-left">
    <button class="icon-btn mobile-menu" onclick="VP.openSidebar()" aria-label="Open menu"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M3 12h18M3 18h18"/></svg></button>
    <button class="icon-btn desktop-collapse" onclick="VP.toggleSidebar()" aria-label="Toggle sidebar"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M3 12h18M3 18h18"/></svg></button>
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <% if (crumbs.length) { crumbs.forEach((b,i)=>{ %>
        <% if(i>0){ %><span class="crumb-sep">/</span><% } %>
        <% if(b.href){ %><a href="<%=b.href%>"><%=b.label%></a><% } else { %><span class="crumb-current"><%=b.label%></span><% } %>
      <% }) } else { %><span class="crumb-current">vPanel</span><% } %>
    </nav>
  </div>
  <div class="topbar-right">
    <div class="top-search"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg><input id="globalSearch" placeholder="Search servers..." onkeydown="if(event.key==='Enter'){VP.globalSearch(this.value)}"></div>
    <a class="icon-btn" href="/notifications" title="Notifications"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 7-3 7h18s-3 0-3-7"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg></a>
    <div class="user-menu" onclick="this.classList.toggle('open')">
      <div class="avatar"><%= (user?.username||'U')[0].toUpperCase() %></div>
      <div class="user-meta hide-mobile"><div class="user-name"><%= user?.username || 'User' %></div><div class="user-role"><%= user?.role || 'user' %></div></div>
      <svg class="hide-mobile" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><polyline points="6 9 12 15 18 9"/></svg>
      <div class="user-dropdown" onclick="event.stopPropagation()">
        <a href="/account/profile">Profile</a>
        <a href="/account/security">Security</a>
        <a href="/account/settings">Settings</a>
        <% if (user && (user.role==='admin'||user.root_admin)) { %><a href="/admin">Admin Panel</a><% } %>
        <hr>
        <a href="/logout" class="danger">Logout</a>
      </div>
    </div>
  </div>
</header>
